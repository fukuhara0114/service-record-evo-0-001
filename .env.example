APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = HTTPリクエスト内で即実行（queue:work 不要）。長時間PDF変換は PHP/IIS タイムアウトに注意。
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REMAND_NOTIFY_BCC=hiroyukifukuhara@xrite.com

# --- Gmail SMTP（システム通知の送信 / 通電確認） ---
# Google アカウントで 2 段階認証 → アプリパスワード発行後に設定:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=your-system@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM_ADDRESS=your-system@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"
# 通電確認: php artisan mail:test you@example.com

# --- Gmail IMAP（受信監視 / Outlook deeplink 保存） ---
# 未設定時は MAIL_USERNAME / MAIL_PASSWORD を流用します。
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
# GMAIL_IMAP_ENCRYPTION=ssl
# GMAIL_IMAP_USERNAME=
# GMAIL_IMAP_PASSWORD=
# GMAIL_IMAP_MAILBOX=INBOX
# GMAIL_IMAP_INITIAL_LOOKBACK_DAYS=7
# GMAIL_OUTLOOK_DEEPLINK_HOSTS=outlook.office.com,outlook.office365.com,outlook.live.com
# 手動実行: php artisan gmail:poll-inbox
# ドライラン: php artisan gmail:poll-inbox --dry-run
# 定期実行: タスクスケジューラで毎分 php artisan schedule:run

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POWER_AUTOMATE_API_KEY=

# Gemini OCR（案件登録）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120

# 撮影画像の保存ルート（この下に /image と /thumbnail）
# 相対パスは storage/app 基準（非公開）。絶対パスも可。
# 配信はアプリの認証付きURL経由のみ。
CAPTURED_IMAGE_ROOT=uploadedImage
# 縦横どちらか長い辺の最大ピクセル数
CAPTURED_IMAGE_MAX_EDGE=1024
# JPEG 品質（1-100）
CAPTURED_IMAGE_JPEG_QUALITY=90
# サムネイルの最大辺ピクセル数
CAPTURED_IMAGE_THUMBNAIL_MAX_EDGE=320

# -----------------------------------------------------------------------------
# PDF / 画像 自動取込（Windows Server + Ghostscript + FPDI/TCPDF）
# -----------------------------------------------------------------------------
# Ghostscript 実行ファイル（PDF 互換変換に使用。未設定時は PDF をそのまま登録）
# スペース含む場合はダブルクォート＋/区切り
PDF_IMPORT_GHOSTSCRIPT_PATH="C:/Program Files/gs/gs10.04.0/bin/gswin64c.exe"

# 5 フォルダ（いずれも絶対パス推奨。Windows は / 区切り＋必要ならダブルクォート）
PDF_IMPORT_INBOX_PATH="C:/inetpub/wwwroot/dev/git_test/service-record-evo-0-001/storage/app/pdf_import/inbox"
PDF_IMPORT_CONVERTED_PATH="C:/inetpub/wwwroot/dev/git_test/service-record-evo-0-001/storage/app/pdf_import/converted"
PDF_IMPORT_REFERENCE_PATH="C:/inetpub/wwwroot/dev/git_test/service-record-evo-0-001/storage/app/pdf_import/reference"
# Ghostscript / FPDI の作業 temp（必ずローカルディスク。UNC 共有上では TCPDF が書き込めない）
PDF_IMPORT_WORK_TEMP_PATH="C:/inetpub/wwwroot/dev/git_test/service-record-evo-0-001/storage/app/pdf_import/work_temp"
PDF_IMPORT_TEMP_PATH="C:/inetpub/wwwroot/dev/git_test/service-record-evo-0-001/storage/app/pdf_import/temp"
PDF_IMPORT_ERROR_PATH="C:/inetpub/wwwroot/dev/git_test/service-record-evo-0-001/storage/app/pdf_import/error"

# Ghostscript PDF 互換変換（FPDI 向け）。主経路は pdfwrite
PDF_IMPORT_COMPATIBILITY_LEVEL=1.4
PDF_IMPORT_PDF_SETTINGS=/prepress
PDF_IMPORT_GS_TIMEOUT=300

# 画像取込向け（PNG→JPEG 品質など）。旧 JPG ラスタ化キーも互換のため残置
PDF_IMPORT_JPEG_QUALITY=85
PDF_IMPORT_DPI=150
PDF_IMPORT_PAPER_SIZE=a4
PDF_IMPORT_FIT_PAGE=true
PDF_IMPORT_GS_DEVICE=jpeg

# DB 登録
PDF_IMPORT_DEFAULT_ASSOCIATED_ID=-1
PDF_IMPORT_SORT_STEP=10
PDF_IMPORT_DOCUMENT_TYPE=画像
PDF_IMPORT_PDF_DOCUMENT_TYPE=PDF

# 多重実行ロック
PDF_IMPORT_LOCK_KEY=file_import_lock
PDF_IMPORT_LOCK_SECONDS=60

# Microsoft Purview 秘密度ラベル（abroad Excel）。Public ラベル付き xlsx の LabelInfo.xml から取得
MSIP_PUBLIC_LABEL_ID=
MSIP_SITE_ID=

# xsrv.jp Sync SM 認証（auth.php?key=...）
XSRV_AUTH_URL=https://xs202381.xsrv.jp/servicerecord/auth.php
XSRV_API_KEY=
